{
  "name": "igle-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @igle/web dev",
    "dev:preview": "pnpm --filter @igle/preview dev",
    "dev:worker": "pnpm --filter @igle/worker dev",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "igle": "tsx scripts/igle.ts"
  },
  "dependencies": {
    "@igle/ai": "workspace:*",
    "@igle/build": "workspace:*",
    "@igle/core": "workspace:*",
    "@igle/deployer": "workspace:*",
    "@igle/html-engine": "workspace:*",
    "@igle/integrations": "workspace:*",
    "@igle/shared": "workspace:*",
    "@igle/templates": "workspace:*",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "cheerio": "^1.1.2",
    "chardet": "^2.1.0",
    "fastify": "^5.5.0",
    "franc": "^6.2.0",
    "iconv-lite": "^0.6.3",
    "magic-string": "^0.30.18",
    "nunjucks": "^3.2.4",
    "parse5": "^7.3.0",
    "pino": "^9.9.5",
    "sharp": "^0.34.3",
    "simple-git": "^3.28.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nunjucks": "^3.2.6",
    "@vitejs/plugin-react": "^5.0.2",
    "next": "^15.5.3",
    "playwright": "^1.55.0",
    "prisma": "^6.16.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
