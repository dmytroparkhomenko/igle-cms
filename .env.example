NODE_ENV=development
DATABASE_URL=postgresql://igle:igle@postgres:5432/igle
REDIS_URL=redis://redis:6379
IGLE_DATA_DIR=/data
BETTER_AUTH_SECRET=change-me
WEB_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://localhost:3001

# aaPanel VPS connection, for sites with deploymentTarget: "aapanel". Copy this file to
# .env (git-ignored) and fill in your real values there — never put real secrets in this file.
AAPANEL_BASE_URL=
AAPANEL_API_KEY=

# First-run only: creates the first administrator account (and seeds the shared team password)
# the moment the app starts with no users yet. Safe to leave set afterward — it's a no-op once
# any user exists. Set your own real email/password in .env, never here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
