NODE_ENV=development
DATABASE_URL=postgresql://igle:igle@postgres:5432/igle
REDIS_URL=redis://redis:6379
IGLE_DATA_DIR=/data
BETTER_AUTH_SECRET=change-me
WEB_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://localhost:3001
# If the preview service isn't directly reachable on its own port from a visitor's browser (common
# behind a reverse proxy that only exposes 80/443 — e.g. docker/caddy/Caddyfile's
# `handle_path /preview/*`), set BOTH of these together instead: PREVIEW_ORIGIN to the web app's own
# public address with that path appended (e.g. http://your-domain:8080/preview), and
# PREVIEW_BASE_PATH to that same path (e.g. /preview) so the preview service emits correct
# self-referencing links (its bridge script, image/asset URLs) under that prefix. Leave both as
# shown above (no path) when the preview service's own port is directly reachable — e.g. local dev.
PREVIEW_BASE_PATH=

# aaPanel VPS connection, for sites with deploymentTarget: "aapanel". Copy this file to
# .env (git-ignored) and fill in your real values there — never put real secrets in this file.
AAPANEL_BASE_URL=
AAPANEL_API_KEY=

# First-run only: creates the first administrator account (and seeds the shared team password)
# the moment the app starts with no users yet. Safe to leave set afterward — it's a no-op once
# any user exists. Set your own real email/password in .env, never here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
